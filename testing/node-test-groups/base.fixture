use super::*;

// A comment naming UdpSocket, TcpStream and node.start() is not a use.
/// Nor is a doc comment: `UdpTransport::new(...).start()`.
#[test]
fn loopback_only() {
    // Inside the body too: a comment naming TcpListener::bind is not a use.
    /* Nor a block comment /* nested */ naming node.start(). */
    let _node = make_node();
    let text = "UdpSocket::bind(\"127.0.0.1:0\") and run_rx_loop() in a string";
    let raw = r#"he said " TcpListener::bind is text"#;
    let _ = (text, raw, 'x', '\'');
}

#[test]
fn calls_a_local_helper_named_like_a_socket_helper() {
    bound_transport_free();
}

/// Same name pattern as a socket helper elsewhere, but its own, socket-free.
fn bound_transport_free() {}
