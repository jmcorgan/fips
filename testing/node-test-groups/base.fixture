use super::*;
use crate::transport::udp::UdpTransport;

/// A started UDP transport on loopback: binds a real socket.
pub(super) async fn bound_transport() -> UdpTransport {
    let mut t = UdpTransport::new(TransportId::new(1), None, UdpConfig::default(), tx());
    t.start_async().await.unwrap();
    t
}
