use super::*;

/// The exempted function, now also binding a socket of another kind: the
/// exemption covers UdpTransport only, so this still flags the module.
fn built_but_never_started() -> crate::transport::udp::UdpTransport {
    let _peer = std::net::UdpSocket::bind("127.0.0.1:0").unwrap();
    crate::transport::udp::UdpTransport::new(TransportId::new(9), None, UdpConfig::default(), tx())
}

#[test]
fn a_dead_transport_fails_to_send() {
    let _t = built_but_never_started();
}
