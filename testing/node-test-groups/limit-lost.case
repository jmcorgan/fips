# Both a profile's default limit and a known-slow override have lost
# terminate-after, so a hung test would run until the job's timeout cancels it.
expect exit 1
expect FAIL
expect [profile.ci] the profile: slow-timeout must set terminate-after
expect [profile.ci] override 3: slow-timeout must set terminate-after
expect check-node-test-groups: 2 finding(s)
=== .config/nextest.toml
nextest-version = { required = "0.9.149" }

[test-groups]
node-large = { max-threads = 1 }
node-synthetic = { max-threads = 1 }

[profile.default]
slow-timeout = { period = "60s", terminate-after = 5 }

[profile.ci]
slow-timeout = { period = "60s" }

[[profile.default.overrides]]
filter = 'package(fips-mesh) & test(/^node::tests::(big::test_big_100_nodes|big::test_big_via_helper|sock_direct::test_sock_100_nodes)$/)'
test-group = 'node-large'

[[profile.default.overrides]]
filter = 'package(fips-mesh) & test(/^node::tests::(helpers|rx_shutdown|via_connected|pathed|sock_direct|via_helper|via_testutil|via_two_hops|on_another_trunk)::/)'
test-group = 'node-synthetic'

[[profile.ci.overrides]]
filter = 'package(fips-mesh) & test(/^node::tests::(big::test_big_100_nodes|big::test_big_via_helper|sock_direct::test_sock_100_nodes)$/)'
test-group = 'node-large'

[[profile.ci.overrides]]
filter = 'package(fips-mesh) & test(/^node::tests::(helpers|rx_shutdown|via_connected|pathed|sock_direct|via_helper|via_testutil|via_two_hops|on_another_trunk)::/)'
test-group = 'node-synthetic'

[[profile.ci.overrides]]
filter = 'test(slow)'
slow-timeout = "120s"
