use super::*;

#[tokio::test]
async fn opens_a_socket_from_a_nested_file() {
    let sock = tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap();
    drop(sock);
}

#[tokio::test]
async fn test_nested_100_nodes() {
    let _guard = super::super::big::lock_large_network_test().await;
}
