# The config does not pin nextest-version.required.
expect exit 2
expect nextest-version.required must be an exact version
=== .config/nextest.toml

[test-groups]
node-large = { max-threads = 1 }
node-synthetic = { max-threads = 1 }

[[profile.default.overrides]]
filter = 'package(fips-mesh) & test(/^node::tests::(big::test_big_100_nodes|big::test_big_via_helper|sock_direct::test_sock_100_nodes)$/)'
test-group = 'node-large'

[[profile.default.overrides]]
filter = 'package(fips-mesh) & test(/^node::tests::(helpers|rx_shutdown|via_connected|pathed|sock_direct|via_helper|via_testutil|via_two_hops|on_another_trunk)::/)'
test-group = 'node-synthetic'

[[profile.ci.overrides]]
filter = 'package(fips-mesh) & test(/^node::tests::(big::test_big_100_nodes|big::test_big_via_helper|sock_direct::test_sock_100_nodes)$/)'
test-group = 'node-large'

[[profile.ci.overrides]]
filter = 'package(fips-mesh) & test(/^node::tests::(helpers|rx_shutdown|via_connected|pathed|sock_direct|via_helper|via_testutil|via_two_hops|on_another_trunk)::/)'
test-group = 'node-synthetic'

[[profile.ci.overrides]]
filter = 'test(slow)'
slow-timeout = "120s"
