# Gateway is not enabled by default. Enable with: systemctl enable --now fips-gateway
[Unit]
Description=FIPS Outbound LAN Gateway
After=fips.service
Requires=fips.service

[Service]
Type=simple
ExecStart=/usr/bin/fips-gateway --config /etc/fips/fips.yaml
Restart=on-failure
RestartSec=5
# Back off between automatic restarts: 5s, 7s, 10s, 15s, 21s, then 30s. The
# step count is cleared by a stop then start, a restart while the unit is
# running, or systemctl reset-failed. A run that succeeds does not clear it,
# nor does a restart while the unit is waiting to restart. systemd before v254
# ignores these two keys and keeps the fixed 5s delay.
RestartSteps=5
RestartMaxDelaySec=30
StandardOutput=journal
StandardError=journal
TimeoutStopSec=15

# Security hardening (needs CAP_NET_ADMIN for nftables and proxy NDP)
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=no

[Install]
WantedBy=multi-user.target
